# ==========================================
# ClassConnect Backend Environment Configuration
# ==========================================

# Server Port & Allowed CORS Client URLs (comma-separated for multiple origins)
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173,http://localhost:3000

# Database Connection (MongoDB Atlas Cluster / Local Instance)
MONGO_URI=mongodb://localhost:27017/ClassConnect

# Redis Cloud / Local Redis Connection (Session & Rate Limit)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=

# JSON Web Token (JWT) Security Configuration
JWT_SECRET=classconnect_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# Cloudinary Media Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Payment Gateways (Razorpay & Stripe Integration)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
STRIPE_SECRET_KEY=sk_test_your_stripe_secret

# SMTP Email Notification Dispatch (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
